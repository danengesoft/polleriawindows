# Copiar a .env.production (0600). Sin valores funcionales por defecto.
COMPOSE_PROJECT_NAME=polleria-production
IMAGE_TAG=release-REPLACE
APP_DOMAIN=REPLACE_WITH_APPROVED_DOMAIN
PUBLIC_APP_URL=https://REPLACE_WITH_APPROVED_DOMAIN
# Mantener cerrado hasta autorización explícita de publicación.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
ORACLE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ORACLE_APP_USER=POLLERIA
ORACLE_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
